{
  "manifest_version": 3,
  "name": "Tabs Watch",
  "version": "2.0.0",
  "description": "Saves the articles you open, summarises them with a local AI model, and shows your knowledge on every new tab. Nothing leaves your device.",
  "permissions": ["tabs", "storage", "alarms", "scripting", "unlimitedStorage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "icons": { "48": "icon.png", "128": "icon.png" }
}
